# Final HTTPS origin, without a path. Optional for previews.
SITE_URL=
# Server-only HTTPS endpoint accepting JSON and returning 2xx after accepting intake.
INTAKE_WEBHOOK_URL=
# Optional Bearer credential sent only to that endpoint.
INTAKE_WEBHOOK_TOKEN=
# Public tracking configuration (optional); enabled only on production Vercel builds.
GA4_ID=
GOOGLE_ADS_ID=
GOOGLE_ADS_FORM_LABEL=
GOOGLE_ADS_CALL_LABEL=
# Server-only Meta CAPI and persistent duplicate protection.
META_CAPI_ACCESS_TOKEN=
META_DATASET_ID=
META_GRAPH_API_VERSION=v25.0
# Required for local/preview testing; remove from production after validation.
META_TEST_EVENT_CODE=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Vercel Marketplace installs these aliases instead; either pair is supported.
KV_REST_API_URL=
KV_REST_API_TOKEN=
